{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "opus",

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-lint-hook.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run test)",
      "Bash(npm run test -- :*)",
      "Bash(npm run secrets)",
      "Bash(npm run backlog)",
      "Bash(npm run backlog:check)",
      "Bash(npm run verify)",
      "Bash(npm run verify:full)",
      "Bash(npm run bundle)",
      "Bash(npm run format)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(node scripts/backlog.mjs:*)",
      "Bash(bash scripts/check-secrets.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
