{
  "name": "plants",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "setup": "git config core.hooksPath scripts/hooks && git config blame.ignoreRevsFile .git-blame-ignore-revs && chmod +x scripts/*.sh scripts/hooks/* && echo 'Git hooks enabled (core.hooksPath=scripts/hooks).'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "bash scripts/check-secrets.sh",
    "backlog": "node scripts/backlog.mjs",
    "backlog:check": "node scripts/backlog.mjs --check",
    "bundle": "expo export --output-dir .bundle-check --clear",
    "e2e:web": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run test && npm run secrets && npm run backlog:check",
    "verify:full": "npm run verify && npm run bundle"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~55.0.31",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "babel-preset-expo": "~55.0.0",
    "eslint": "^10.11.0",
    "eslint-config-expo": "^55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "prettier": "^3.9.9"
  }
}
