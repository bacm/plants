# Domain the Caddy reverse proxy serves and gets a TLS certificate for.
# A free alternative to a real domain: <ip-with-dashes>.sslip.io, e.g.
# 203-0-113-10.sslip.io resolves to 203.0.113.10.
API_DOMAIN=plants-api.example.com

OPENAI_API_KEY=

# Comma-separated bearer tokens accepted on /search, one per device. Generate
# each with: openssl rand -hex 32
API_TOKENS=

SEARCH_DAILY_BUDGET=500

# Only needed if the web build calls this server directly (CORS). Leave
# empty for native-only use.
ALLOWED_ORIGINS=
