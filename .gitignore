# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: also ignore a node_modules symlink (e.g. in a git worktree).
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Output of `npm run bundle` (the CI bundle smoke test)
.bundle-check/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Claude Code: settings.json is shared and versioned; settings.local.json is
# per-developer (personal permission grants) and must not be.
.claude/settings.local.json

# typescript
*.tsbuildinfo

# scripts
deploy-iphone.sh

# generated native folders
/ios
/android
/dist-release

# Plant search server (server/)
server/.venv/
__pycache__/
.pytest_cache/

# Playwright (npm run e2e:web)
/test-results/
/playwright-report/

# Maestro (npm run e2e:ios)
/.maestro-output/